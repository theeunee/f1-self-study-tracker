# Copy to .env.local (git-ignored) and fill in from your Supabase project:
# Project Settings → API. Only the anon key may reach the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used only by `npm run seed` on your machine. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SEED_USER_EMAIL=
